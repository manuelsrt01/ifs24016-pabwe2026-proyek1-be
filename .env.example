# Salin menjadi .env lalu sesuaikan. File .env TIDAK boleh di-commit.
PORT=3000
NODE_ENV=development
# Lokasi file SQLite. Di produksi arahkan ke disk persisten, mis. /data/tanaread.db
DB_PATH=./data/tanaread.db
# Zona waktu untuk menentukan "hari ini" pada statistik
APP_TIMEZONE=Asia/Jakarta
# Origin front-end yang diizinkan (pisahkan dengan koma). Tidak diperlukan bila front-end memakai rewrite Vercel (lihat README).
CORS_ORIGIN=http://localhost:5173
# Isi 1 bila server berada di belakang reverse proxy/PaaS (HTTPS dihentikan di proxy)
TRUST_PROXY=0
